{
  "name": "onam-flowers-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onam-flowers-db",
      "database_id": "0b598bd6-e736-4701-983c-db80e1dfb4a9",
      "migrations_dir": "migrations"
    }
  ]
  // R2 bucket — PENDING: enable R2 in Cloudflare dashboard (needs a card on file).
  // Once enabled: npx wrangler r2 bucket create onam-flowers-images
  // then add: "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "onam-flowers-images" }]
}
